{ ... }:

let
  # Chrome profile DIRECTORY -> display name on this machine:
  #   Default   -> "openvpn.com"  (stefan.matic@openvpn.com)  work
  #   Profile 1 -> "Stefan"       (stefanmatic94@gmail.com)   personal
  #
  # These are NOT the same as the linux box, where Default is the personal
  # profile and Profile 2/3 are OpenVPN/Kupoprodaja. Finicky matches on the
  # display name, so the mapping is machine-specific. Re-read it with:
  #   python3 -c 'import json; print(json.load(open(
  #     "$HOME/Library/Application Support/Google/Chrome/Local State"
  #   ))["profile"]["info_cache"])'
  work = {
    name = "Google Chrome";
    profile = "openvpn.com";
  };
  personal = {
    name = "Google Chrome";
    profile = "Stefan";
  };

  # Hosts that open in the personal profile; everything else falls through to
  # work, the right default on a work laptop. Passed to finicky.matchHostnames,
  # which handles subdomains itself.
  personalHosts = [
    "kupoprodaja.ba"
    "youtube.com"
    "reddit.com"
    "twitch.tv"
    "steamcommunity.com"
    "store.steampowered.com"
  ];
in
{
  # Finicky replaces pkgs/select-browser (the kdialog radiolist) on darwin.
  #
  # Different model: select-browser PROMPTS on every link; Finicky ROUTES by
  # rule. It has no interactive picker, so the ad-hoc "send this one
  # elsewhere" case is covered by held modifier keys instead.
  #
  # Finicky must be made the default browser once, by hand. Note it reads the
  # config through the /nix/store path the symlink resolves to, so after a
  # rebuild that changes this file, Finicky needs a restart (or its menu-bar
  # "Reload configuration") before the new rules take effect.
  #
  # Shapes below are taken from the type definitions Finicky ships at
  # /Applications/Finicky.app/Contents/Resources/finicky.d.ts
  home.file.".finicky.js".text = ''
    // Generated by user/app/browser/finicky.nix -- do not edit by hand.

    // Modifier state is read when Finicky HANDLES the url, not when a link is
    // clicked, so this also covers urls an app opens by itself -- e.g. holding
    // shift through a VS Code or gh OAuth hand-off.
    //
    // Signature confirmed against finicky.d.ts (FinickyUtils):
    //   getModifierKeys: () => { shift, option, command, control,
    //                            capsLock, fn }
    // try/catch kept regardless: if it ever changes, links must still open
    // rather than every url silently failing.
    const heldKeys = () => {
      try {
        return finicky.getModifierKeys() || {};
      } catch (e) {
        return {};
      }
    };

    export default {
      defaultBrowser: ${builtins.toJSON work},

      options: {
        // Homebrew owns Finicky's version (hosts/macbook/homebrew.nix), so
        // the built-in updater only adds timeout noise to the log on a flaky
        // connection.
        checkForUpdates: false,
      },

      handlers: [
        {
          // Hold SHIFT to force this one url into the personal profile
          // without writing a rule for it. Checked first, so it wins.
          match: () => heldKeys().shift === true,
          browser: ${builtins.toJSON personal},
        },
        {
          // Hold COMMAND to force the work profile the same way.
          match: () => heldKeys().command === true,
          browser: ${builtins.toJSON work},
        },
        {
          // Personal browsing goes to the personal Chrome profile.
          // matchHostnames covers subdomains without hand-rolled regex.
          match: finicky.matchHostnames(${builtins.toJSON personalHosts}),
          browser: ${builtins.toJSON personal},
        },
      ],

      rewrite: [
        {
          // Strip tracking params from every url before opening it.
          match: () => true,
          url: ({ url }) => {
            const drop = [
              "utm_source", "utm_medium", "utm_campaign",
              "utm_term", "utm_content", "fbclid", "gclid",
            ];
            return {
              ...url,
              search: url.search
                .split("&")
                .filter((p) => p && !drop.includes(p.split("=")[0]))
                .join("&"),
            };
          },
        },
      ],
    };
  '';
}
